---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import TerminalMock from '../components/TerminalMock.astro';
import InstagramModalMock from '../components/InstagramModalMock.astro';
import InteractiveTool from '../components/InteractiveTool.astro';

// ── Scripts to display ──────────────────────────────────────────────────────

const followersScript = `const followers = new Set();

const scrollable = [...document.querySelectorAll('div')]
  .find(el => el.style.cssText.includes('overflow: hidden auto'));

if (!scrollable) {
  console.warn('⚠️ Open the Followers modal first, then re-run.');
} else {
  const collect = () => {
    document.querySelectorAll('span._ap3a._aaco._aacw._aacx._aad7._aade')
      .forEach(span => {
        const username = span.innerText.trim();
        if (username) followers.add(username);
      });
    console.log(\`📋 Captured so far: \${followers.size} followers\`);
  };

  const observer = new MutationObserver(collect);
  observer.observe(scrollable, { childList: true, subtree: true });
  collect();

  window._stopFollowerCollect = () => {
    observer.disconnect();
    const list = [...followers];
    const json = JSON.stringify(list, null, 2);
    localStorage.setItem('ig_followers_snapshot', JSON.stringify(list));
    console.log(\`✅ Done! \${list.length} followers captured.\`);
    console.log('');
    console.log('━━━━━━━━━━ COPY FROM HERE ━━━━━━━━━━');
    console.log(json);
    console.log('━━━━━━━━━━  COPY TO HERE  ━━━━━━━━━━');
    console.log('');
    navigator.clipboard.writeText(json)
      .then(() => console.log('📋 Copied to clipboard! Now refresh the page and run Script 2.'))
      .catch(() => console.log('💾 Saved to localStorage. Manually copy the JSON above, then refresh and run Script 2.'));
    return list;
  };

  console.log('🚀 Collector running. Scroll through the Followers modal.');
  console.log('👉 When done, run: window._stopFollowerCollect()');
}`;

const stopFollowersCmd = `window._stopFollowerCollect()`;

const followingScript = `const following = new Set();
const followers = new Set(JSON.parse(localStorage.getItem('ig_followers_snapshot') || '[]'));

if (!followers.size) {
  console.warn('⚠️ Followers snapshot not found — did you run Script 1 first?');
}

const scrollable2 = [...document.querySelectorAll('div')]
  .find(el => el.style.cssText.includes('overflow: hidden auto'));

if (!scrollable2) {
  console.warn('⚠️ Open the Following modal first, then re-run.');
} else {
  const collect = () => {
    document.querySelectorAll('span._ap3a._aaco._aacw._aacx._aad7._aade')
      .forEach(span => {
        const username = span.innerText.trim();
        if (username && username !== 'Following') following.add(username);
      });
    console.log(\`📋 Captured so far: \${following.size} following\`);
  };

  const observer2 = new MutationObserver(collect);
  observer2.observe(scrollable2, { childList: true, subtree: true });
  collect();

  window._stopFollowingCollect = () => {
    observer2.disconnect();
    const notFollowingBack = [...following].filter(u => !followers.has(u));
    console.log('✅ Done!');
    console.log(\`Following: \${following.size}\`);
    console.log(\`Don't follow back: \${notFollowingBack.length}\`);
    console.log(JSON.stringify(notFollowingBack, null, 2));
    return notFollowingBack;
  };

  console.log('🚀 Scroll through Following modal.');
  console.log('👉 When done, run: window._stopFollowingCollect()');
}`;

const stopFollowingCmd = `window._stopFollowingCollect()`;

// ── Terminal line sets ───────────────────────────────────────────────────────

const termCollect = [
  '🚀 Collector running. Scroll through the Followers modal.',
  '👉 When done, run: window._stopFollowerCollect()',
  '📋 Captured so far: 4 followers',
  '📋 Captured so far: 19 followers',
  '📋 Captured so far: 47 followers',
  '📋 Captured so far: 91 followers',
  '📋 Captured so far: 127 followers',
];

const termStop = [
  '> window._stopFollowerCollect()',
  '✅ Done! 127 followers captured.',
  '',
  '━━━━━━━━━━ COPY FROM HERE ━━━━━━━━━━',
  '[',
  '  "alex.fitness",',
  '  "sarah_k",',
  '  "jjboss22",',
  '  ... 124 more',
  ']',
  '━━━━━━━━━━  COPY TO HERE  ━━━━━━━━━━',
  '',
  '📋 Copied to clipboard! Now refresh the page and run Script 2.',
];

const termFollowing = [
  '🚀 Scroll through Following modal.',
  '👉 When done, run: window._stopFollowingCollect()',
  '📋 Captured so far: 18 following',
  '📋 Captured so far: 76 following',
  '📋 Captured so far: 189 following',
  '📋 Captured so far: 312 following',
  '> window._stopFollowingCollect()',
  '✅ Done!',
  'Following: 312',
  "Don't follow back: 255",
];
---

<Layout>

  <!-- ══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center px-6 bg-white overflow-hidden">

    <!-- Subtle radial glow in the background -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 70% 50% at 50% 60%, rgba(255,107,0,0.06) 0%, transparent 70%);"
    ></div>

    <div class="hero-content relative z-10 text-center max-w-4xl mx-auto">
      <!-- Eyebrow -->
      <p class="hero-eyebrow text-sm font-semibold uppercase tracking-widest text-apple-muted mb-8">
        Browser-only · No app · No login · You decide who
      </p>

      <!-- Headline -->
      <h1 class="hero-headline font-bold tracking-tight leading-[1.05] text-apple-black mb-6"
          style="font-size: clamp(3rem, 8vw, 6rem);">
        Clean up your following list,
        <br />
        <span class="text-gradient-animated">on your terms.</span>
      </h1>

      <!-- Sub -->
      <p class="hero-sub text-xl md:text-2xl text-apple-gray max-w-2xl mx-auto leading-relaxed mb-12">
        See who doesn't follow you back, review them one by one, and choose who to unfollow.
        Runs entirely in your browser — no data leaves your machine.
      </p>

      <!-- CTA -->
      <a
        href="#step1"
        class="hero-cta inline-flex items-center gap-2 px-8 py-4 rounded-2xl font-semibold text-white text-lg transition-all duration-200 hover:scale-[1.03] active:scale-[0.98]"
        style="background: linear-gradient(135deg, #FF6B00, #FF9A3C); box-shadow: 0 8px 30px rgba(255,107,0,0.35);"
      >
        Get started
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 scroll-bounce">
      <div class="w-px h-8 bg-gradient-to-b from-transparent to-apple-muted/50"></div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#86868B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       STEP 1 — Open your followers list
  ═══════════════════════════════════════════ -->
  <section id="step1" class="py-32 px-6 bg-[#F5F5F7]">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">

      <!-- Text -->
      <div class="will-animate">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-4">Step 1</p>
        <h2 class="text-4xl md:text-5xl font-bold text-apple-black tracking-tight leading-tight mb-6">
          Open your followers list
        </h2>
        <p class="text-lg text-apple-gray leading-relaxed mb-4">
          Go to your Instagram profile on desktop and click your <strong class="text-apple-black font-semibold">Followers</strong> count to open the modal.
        </p>
        <p class="text-apple-muted font-mono text-sm bg-white rounded-xl px-4 py-2.5 inline-block border border-gray-100">
          instagram.com/<em>yourname</em>/
        </p>
      </div>

      <!-- IG Modal Mock -->
      <div class="flex justify-center md:justify-end">
        <InstagramModalMock />
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       STEP 1b — Run the collector
  ═══════════════════════════════════════════ -->
  <section class="py-32 px-6 bg-white">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">

      <!-- Terminal (left) -->
      <div class="flex flex-col gap-4 min-w-0">
        <TerminalMock lines={termCollect} id="term-collect" />
        <p class="text-sm text-apple-muted pl-2">
          As you scroll the modal, the collector captures every visible username in real time.
        </p>
      </div>

      <!-- Code block (right) -->
      <div class="will-animate min-w-0">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-4">Step 1 — continued</p>
        <h2 class="text-4xl md:text-5xl font-bold text-apple-black tracking-tight leading-tight mb-6">
          Run the collector
        </h2>
        <p class="text-lg text-apple-gray leading-relaxed mb-8">
          Open <strong class="text-apple-black font-semibold">DevTools → Console</strong> (F12), paste this script and press Enter. Then scroll slowly through the entire Followers modal.
        </p>
        <CodeBlock code={followersScript} label="Script 1 — followers collector" id="code-followers" />
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       STEP 2 — Stop the collector
  ═══════════════════════════════════════════ -->
  <section class="py-32 px-6 bg-[#F5F5F7]">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">

      <!-- Text + Code (left) -->
      <div class="will-animate min-w-0">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-4">Step 2</p>
        <h2 class="text-4xl md:text-5xl font-bold text-apple-black tracking-tight leading-tight mb-6">
          Stop the collector
        </h2>
        <p class="text-lg text-apple-gray leading-relaxed mb-8">
          Once you've scrolled through every follower, run this command to stop and print your complete followers list as JSON. <strong class="text-apple-black font-semibold">Copy and save it</strong> — you'll need it in a moment.
        </p>
        <CodeBlock code={stopFollowersCmd} label="Stop command" id="code-stop-followers" />
      </div>

      <!-- Terminal (right) -->
      <div class="flex flex-col gap-4 md:pt-24 min-w-0">
        <TerminalMock lines={termStop} id="term-stop" />
        <p class="text-sm text-apple-muted pl-2">
          The JSON array is your followers list. Copy everything between the brackets.
        </p>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       REFRESH DIVIDER
  ═══════════════════════════════════════════ -->
  <div class="px-6 bg-white">
    <div class="max-w-6xl mx-auto py-4">
      <div class="will-animate flex flex-col items-center gap-3">

        <!-- Vertical connector line top -->
        <div class="w-px h-8 bg-gradient-to-b from-transparent to-gray-200"></div>

        <!-- Refresh pill -->
        <div
          class="flex items-center gap-3 px-5 py-3 rounded-2xl border border-gray-200 bg-[#F5F5F7] shadow-sm"
        >
          <!-- Icon -->
          <div class="w-8 h-8 rounded-full flex items-center justify-center bg-white border border-gray-200 shadow-sm flex-shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#86868B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"/>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-apple-black leading-none mb-0.5">Save your followers list, then refresh</p>
            <p class="text-xs text-apple-muted leading-snug">Copy the JSON from your console, refresh the tab, then continue with Script 2.</p>
          </div>
        </div>

        <!-- Vertical connector line bottom -->
        <div class="w-px h-8 bg-gradient-to-b from-gray-200 to-transparent"></div>

      </div>
    </div>
  </div>


  <!-- ══════════════════════════════════════════
       STEP 3 — Repeat for Following
  ═══════════════════════════════════════════ -->
  <section class="py-32 px-6 bg-white">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">

      <!-- Terminal (left) -->
      <div class="flex flex-col gap-4 min-w-0">
        <TerminalMock lines={termFollowing} id="term-following" />
        <p class="text-sm text-apple-muted pl-2">
          The diff is automatic — the script filters out anyone who follows you back.
        </p>
      </div>

      <!-- Text + Code (right) -->
      <div class="will-animate">
        <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-4">Step 3</p>
        <h2 class="text-4xl md:text-5xl font-bold text-apple-black tracking-tight leading-tight mb-6">
          Repeat for Following
        </h2>
        <p class="text-lg text-apple-gray leading-relaxed mb-4">
          After refreshing, open the <strong class="text-apple-black font-semibold">Following</strong> modal and run this collector. Scroll through it completely.
        </p>
        <p class="text-lg text-apple-gray leading-relaxed mb-8">
          When done, run the stop command. Script 2 loads your saved followers list automatically and computes the diff — you get only the people who don't follow you back.
        </p>
        <div class="space-y-4">
          <CodeBlock code={followingScript} label="Script 2 — following collector" id="code-following" />
          <CodeBlock code={stopFollowingCmd} label="Stop command" id="code-stop-following" />
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       STEP 4 — The Interactive Tool
  ═══════════════════════════════════════════ -->
  <InteractiveTool />


  <!-- ══════════════════════════════════════════
       FOOTER
  ═══════════════════════════════════════════ -->
  <footer class="py-12 px-6 bg-[#F5F5F7] border-t border-gray-100">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-apple-muted">
        Runs entirely in your browser. No data is sent anywhere.
      </p>
      <p class="text-sm text-apple-muted">
        Open source — use it, fork it, improve it.
      </p>
    </div>
  </footer>


</Layout>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

// ── Hero entrance ──────────────────────────────────────────────────────────
// gsap.set() hides immediately, gsap.to() reveals — no CSS opacity:0 needed
gsap.set(['.hero-eyebrow', '.hero-headline', '.hero-sub', '.hero-cta'], { opacity: 0, y: 0 });
gsap.set('.hero-headline', { y: 20 });
gsap.set('.hero-eyebrow', { y: 16 });
gsap.set('.hero-sub', { y: 16 });
gsap.set('.hero-cta', { y: 12 });

gsap.to('.hero-eyebrow', { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.15 });
gsap.to('.hero-headline', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: 0.3 });
gsap.to('.hero-sub',      { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.5 });
gsap.to('.hero-cta',      { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.65 });

// ── Generic section entrances (.will-animate) ──────────────────────────────
// Set initial hidden state via JS (not CSS) so elements are visible if JS fails
const animateEls = document.querySelectorAll<HTMLElement>('.will-animate');
gsap.set(animateEls, { opacity: 0, y: 44 });

animateEls.forEach((el) => {
  gsap.to(el, {
    opacity: 1,
    y: 0,
    duration: 0.85,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: el,
      start: 'top 85%',
    },
  });
});

// ── Instagram modal mock ────────────────────────────────────────────────────
const igModal = document.getElementById('ig-modal');
if (igModal) {
  ScrollTrigger.create({
    trigger: igModal,
    start: 'top 80%',
    onEnter: () => {
      igModal.classList.add('visible');
      setTimeout(() => {
        igModal.querySelector('#ig-modal-list')?.classList.add('ig-modal-active');
      }, 350);
    },
  });
}

// ── Terminal line reveals ───────────────────────────────────────────────────
function activateTerminal(terminalId: string) {
  const lines = document.querySelectorAll<HTMLElement>(
    `[data-terminal-id="${terminalId}"]`
  );
  lines.forEach((line, i) => {
    setTimeout(() => line.classList.add('visible'), i * 220);
  });
}

// Set terminals hidden initially via JS
const termIds = ['term-collect', 'term-stop', 'term-following'];
termIds.forEach((id) => {
  const el = document.getElementById(id);
  if (el) gsap.set(el, { opacity: 0, y: 40 });
});

termIds.forEach((id) => {
  const el = document.getElementById(id);
  if (!el) return;
  let triggered = false;
  ScrollTrigger.create({
    trigger: el,
    start: 'top 82%',
    onEnter: () => {
      if (triggered) return;
      triggered = true;
      gsap.to(el, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' });
      setTimeout(() => activateTerminal(id), 400);
    },
  });
});
</script>
