---
interface Props {
  title?: string;
}
const { title = 'IG Unfollow Tool — Clean up who doesn\'t follow back' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A clean, transparent browser tool to unfollow Instagram accounts that don't follow you back. No app, no login, runs entirely in your console." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: #ffffff;
        color: #1D1D1F;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
        overflow-x: hidden;
      }

      /* Orange gradient text utility */
      .text-gradient {
        background: linear-gradient(135deg, #FF6B00 0%, #FF9A3C 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Animated gradient shift on hero */
      .text-gradient-animated {
        background: linear-gradient(135deg, #FF6B00 0%, #FF9A3C 50%, #FF6B00 100%);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient-shift 4s ease infinite;
      }

      @keyframes gradient-shift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      /* Scroll indicator bounce */
      @keyframes bounce-down {
        0%, 100% { transform: translateY(0); opacity: 0.5; }
        50%       { transform: translateY(8px); opacity: 1; }
      }

      .scroll-bounce {
        animation: bounce-down 2s ease-in-out infinite;
      }

      /* Terminal line reveal */
      .term-line {
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .term-line.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* IG modal mock row stagger */
      .ig-row {
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity 0.35s ease, transform 0.35s ease;
      }

      .ig-modal-active .ig-row {
        opacity: 1;
        transform: translateX(0);
      }

      .ig-modal-wrapper {
        opacity: 0;
        transform: translateY(24px) scale(0.97);
        transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .ig-modal-wrapper.visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      /* .will-animate initial state is set by gsap.set() in the page script,
         NOT by CSS — that way elements stay visible if JS fails to load */

      /* Disable JetBrains Mono ligatures in code — => should not render as ⇒ */
      pre, code {
        font-variant-ligatures: none;
        font-feature-settings: "liga" 0, "calt" 0;
      }

      /* Smooth copy feedback */
      .copy-btn-feedback {
        transition: background 0.15s ease, color 0.15s ease;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
