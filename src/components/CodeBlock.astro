---
interface Props {
  code: string;
  label?: string;
  id?: string;
}
const { code, label, id } = Astro.props;
---

<div class="code-block will-animate" id={id}>
  {label && (
    <div class="text-xs font-mono text-orange-light mb-3 uppercase tracking-widest">{label}</div>
  )}
  <div class="rounded-2xl overflow-hidden shadow-2xl shadow-black/10 border border-white/5">
    <!-- macOS-style title bar -->
    <div class="flex items-center gap-2 px-4 py-3 bg-[#2A2A2D] border-b border-white/5">
      <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
      <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
      <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
      <span class="ml-auto">
        <button
          class="copy-btn copy-btn-feedback text-xs font-medium px-3 py-1 rounded-md bg-orange/90 hover:bg-orange text-white cursor-pointer border-none"
          data-target-id={id ?? `code-${Math.random().toString(36).slice(2)}`}
        >
          Copy
        </button>
      </span>
    </div>
    <!-- Code content -->
    <pre
      class="code-content m-0 p-6 bg-[#1C1C1E] text-[#E5E5EA] font-mono text-sm leading-relaxed overflow-x-auto"
      id={id ? `${id}-pre` : undefined}
    ><code>{code}</code></pre>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      // Walk from button → title bar → wrapper → find the pre sibling
      const wrapper = btn.closest('.code-block');
      const pre = wrapper?.querySelector('pre');
      if (!pre) return;

      navigator.clipboard.writeText(pre.innerText).then(() => {
        btn.textContent = 'Copied!';
        btn.style.background = '#28C840';
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.style.background = '';
        }, 2000);
      });
    });
  });
</script>
